# ==============================================================================
# SKILLBANK ENVIRONMENT CONFIGURATION
# Copy this file to .env (for local development) or configure in your deployment
# dashboard (Vercel, Railway, Render, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Production (PostgreSQL - Neon, Supabase, Vercel Postgres, AWS RDS):
# DATABASE_URL="postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/skillbank?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 32-byte secret with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-secure-random-secret-in-production-min-32-chars"

# Canonical production deployment URL (e.g. https://skillbank.vercel.app)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. PUBLIC APPLICATION URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SkillBank"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (SMTP / Resend / SendGrid)
# Optional in development: if omitted, password resets and verification links
# are logged safely to the server console and simulated directly.
# ------------------------------------------------------------------------------
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="your-smtp-password"
EMAIL_FROM="SkillBank <no-reply@skillbank.app>"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay India for Courses & Workshops in INR)
# Optional: if omitted, masterclass and workshop registrations run in explicit
# Test Mode with instant enrollment and audit logging.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_signing_secret"

# ------------------------------------------------------------------------------
# 6. CLOUD FILE STORAGE (Uploadthing / AWS S3 / Supabase Storage)
# Optional in development: if omitted, profile avatars use URL links or system
# SVG avatars.
# ------------------------------------------------------------------------------
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""
