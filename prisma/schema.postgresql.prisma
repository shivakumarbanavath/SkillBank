generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                    @id @default(cuid())
  email                      String                    @unique
  emailVerified              DateTime?
  name                       String?
  image                      String?
  role                       String                    @default("USER")
  status                     String                    @default("ACTIVE")
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  accounts                   Account[]
  auditLogs                  AuditLog[]
  availability               Availability[]
  certificates               Certificate[]
  conversationsAsParticipant ConversationParticipant[]
  coursesTaught              Course[]
  creditAccount              CreditAccount?
  creditTransactions         CreditTransaction[]
  enrollments                Enrollment[]
  eventsOrganized            Event[]                   @relation("EventOrganizer")
  eventRegistrations         EventRegistration[]
  groupSessionsTeaching      GroupSession[]            @relation("GroupTeacher")
  groupSessionParticipants   GroupSessionParticipant[]
  learningInterests          LearningInterest[]
  messagesSent               Message[]
  notifications              Notification[]
  payments                   Payment[]
  profile                    Profile?
  reportsReceived            Report[]                  @relation("ReportedReports")
  reportsSubmitted           Report[]                  @relation("ReporterReports")
  reviewsReceived            Review[]                  @relation("ReviewsReceived")
  reviewsGiven               Review[]                  @relation("ReviewsGiven")
  sessions                   Session[]
  sessionsAsLearner          SkillSession[]            @relation("LearnerSessions")
  sessionsAsTeacher          SkillSession[]            @relation("TeacherSessions")
  subscription               Subscription?
  teachingSkills             TeachingSkill[]
  blocksReceived             UserBlock[]               @relation("Blocked")
  blocksGiven                UserBlock[]               @relation("Blocker")
  verificationRequest        VerificationRequest?
  workshopsOrganized         Workshop[]                @relation("WorkshopOrganizer")
  workshopRegistrations      WorkshopRegistration[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  password          String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  username        String   @unique
  displayName     String
  bio             String?
  avatar          String?
  campus          String?
  institution     String?
  city            String?
  country         String   @default("India")
  latitude        Float?
  longitude       Float?
  languages       String   @default("[]")
  preferredFormat String   @default("EITHER")
  onboardingStep  Int      @default(0)
  onboardingDone  Boolean  @default(false)
  isPublic        Boolean  @default(true)
  showEmail       Boolean  @default(false)
  showLocation    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([campus])
  @@index([city])
}

model SkillCategory {
  id                String             @id @default(cuid())
  name              String             @unique
  slug              String             @unique
  icon              String?
  description       String?
  sortOrder         Int                @default(0)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  courses           Course[]
  groupSessions     GroupSession[]
  learningInterests LearningInterest[]
  teachingSkills    TeachingSkill[]
}

model TeachingSkill {
  id            String         @id @default(cuid())
  userId        String
  categoryId    String
  skillName     String
  description   String?
  proficiency   String         @default("INTERMEDIATE")
  format        String         @default("EITHER")
  duration      Int            @default(60)
  prerequisites String?
  tags          String         @default("[]")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      SkillSession[]
  category      SkillCategory  @relation(fields: [categoryId], references: [id])
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoryId])
  @@index([isActive])
  @@index([proficiency])
}

model LearningInterest {
  id         String        @id @default(cuid())
  userId     String
  categoryId String
  skillName  String
  notes      String?
  priority   Int           @default(1)
  createdAt  DateTime      @default(now())
  category   SkillCategory @relation(fields: [categoryId], references: [id])
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, skillName])
  @@index([userId])
  @@index([categoryId])
}

model Availability {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int
  startTime String
  endTime   String
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dayOfWeek])
}

model SkillSession {
  id                 String              @id @default(cuid())
  teacherId          String
  learnerId          String
  teachingSkillId    String
  title              String
  description        String?
  scheduledDate      DateTime
  startTime          String
  durationMinutes    Int                 @default(60)
  format             String
  meetingLink        String?
  location           String?
  status             String              @default("REQUESTED")
  cancelledBy        String?
  cancelReason       String?
  creditCost         Int                 @default(10)
  idempotencyKey     String?             @unique
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  creditReservations CreditReservation[]
  creditTransactions CreditTransaction[]
  reviews            Review[]
  dispute            SessionDispute?
  learner            User                @relation("LearnerSessions", fields: [learnerId], references: [id])
  teacher            User                @relation("TeacherSessions", fields: [teacherId], references: [id])
  teachingSkill      TeachingSkill       @relation(fields: [teachingSkillId], references: [id])

  @@index([teacherId])
  @@index([learnerId])
  @@index([status])
  @@index([scheduledDate])
  @@index([teachingSkillId])
}

model SessionDispute {
  id          String       @id @default(cuid())
  sessionId   String       @unique
  raisedById  String
  reason      String
  description String?
  status      String       @default("OPEN")
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  session     SkillSession @relation(fields: [sessionId], references: [id])

  @@index([status])
}

model CreditAccount {
  id              String              @id @default(cuid())
  userId          String              @unique
  balance         Int                 @default(0)
  reservedBalance Int                 @default(0)
  totalEarned     Int                 @default(0)
  totalSpent      Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations    CreditReservation[]
  transactions    CreditTransaction[]

  @@index([userId])
}

model CreditTransaction {
  id             String        @id @default(cuid())
  userId         String
  accountId      String
  type           String
  amount         Int
  balanceAfter   Int
  sessionId      String?
  description    String
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  account        CreditAccount @relation(fields: [accountId], references: [id])
  session        SkillSession? @relation(fields: [sessionId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
}

model CreditReservation {
  id        String        @id @default(cuid())
  userId    String
  accountId String
  sessionId String
  amount    Int
  status    String        @default("ACTIVE")
  expiresAt DateTime?
  settledAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  account   CreditAccount @relation(fields: [accountId], references: [id])
  session   SkillSession  @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([status])
}

model Review {
  id           String       @id @default(cuid())
  sessionId    String
  reviewerId   String
  revieweeId   String
  rating       Int
  comment      String?
  isReported   Boolean      @default(false)
  reportReason String?
  rewardIssued Boolean      @default(false)
  rewardAmount Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reviewee     User         @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  reviewer     User         @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  session      SkillSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, reviewerId])
  @@index([revieweeId])
  @@index([rating])
  @@index([sessionId])
}

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String
  reportedId   String
  type         String
  targetId     String
  reason       String
  description  String?
  status       String    @default("PENDING")
  resolution   String?
  reviewedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  reported     User      @relation("ReportedReports", fields: [reportedId], references: [id])
  reporter     User      @relation("ReporterReports", fields: [reporterId], references: [id])

  @@index([reportedId])
  @@index([status])
  @@index([type])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model VerificationRequest {
  id           String    @id @default(cuid())
  userId       String    @unique
  type         String
  institution  String?
  campus       String?
  document     String?
  status       String    @default("PENDING")
  reviewedById String?
  reviewNote   String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  plan               String    @default("FREE")
  status             String    @default("ACTIVE")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  paymentProvider    String?
  externalId         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([plan])
}

model GroupSession {
  id              String                    @id @default(cuid())
  teacherId       String
  categoryId      String
  title           String
  description     String?
  skillName       String
  format          String
  scheduledAt     DateTime
  durationMinutes Int                       @default(90)
  capacity        Int                       @default(10)
  enrolledCount   Int                       @default(0)
  creditCost      Int                       @default(5)
  meetingLink     String?
  location        String?
  status          String                    @default("OPEN")
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  category        SkillCategory             @relation(fields: [categoryId], references: [id])
  teacher         User                      @relation("GroupTeacher", fields: [teacherId], references: [id])
  participants    GroupSessionParticipant[]

  @@index([teacherId])
  @@index([status])
  @@index([scheduledAt])
  @@index([categoryId])
}

model GroupSessionParticipant {
  id             String       @id @default(cuid())
  groupSessionId String
  userId         String
  status         String       @default("REGISTERED")
  joinedAt       DateTime     @default(now())
  groupSession   GroupSession @relation(fields: [groupSessionId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([groupSessionId, userId])
  @@index([userId])
  @@index([groupSessionId])
}

model Course {
  id               String        @id @default(cuid())
  instructorId     String
  categoryId       String
  title            String
  slug             String        @unique
  description      String
  shortDesc        String?
  thumbnail        String?
  priceInr         Int           @default(0)
  duration         Int?
  level            String        @default("BEGINNER")
  learningOutcomes String        @default("[]")
  prerequisites    String?
  isPublished      Boolean       @default(false)
  hasCertificate   Boolean       @default(false)
  enrollmentCount  Int           @default(0)
  rating           Float         @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  certificates     Certificate[]
  category         SkillCategory @relation(fields: [categoryId], references: [id])
  instructor       User          @relation(fields: [instructorId], references: [id])
  enrollments      Enrollment[]

  @@index([instructorId])
  @@index([categoryId])
  @@index([isPublished])
  @@index([slug])
}

model Enrollment {
  id          String    @id @default(cuid())
  courseId    String
  userId      String
  status      String    @default("ACTIVE")
  paidAmount  Int       @default(0)
  paymentId   String?
  progress    Int       @default(0)
  completedAt DateTime?
  enrolledAt  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  course      Course    @relation(fields: [courseId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([courseId, userId])
  @@index([userId])
  @@index([courseId])
}

model Certificate {
  id            String   @id @default(cuid())
  userId        String
  courseId      String
  enrollmentId  String?
  certificateNo String   @unique
  issuedAt      DateTime @default(now())
  course        Course   @relation(fields: [courseId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model Workshop {
  id              String                 @id @default(cuid())
  organizerId     String
  title           String
  description     String
  format          String
  scheduledAt     DateTime
  durationMinutes Int                    @default(120)
  capacity        Int                    @default(30)
  registeredCount Int                    @default(0)
  priceInr        Int                    @default(0)
  venue           String?
  meetingLink     String?
  status          String                 @default("OPEN")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  organizer       User                   @relation("WorkshopOrganizer", fields: [organizerId], references: [id])
  registrations   WorkshopRegistration[]

  @@index([organizerId])
  @@index([status])
  @@index([scheduledAt])
}

model WorkshopRegistration {
  id           String   @id @default(cuid())
  workshopId   String
  userId       String
  status       String   @default("REGISTERED")
  paidAmount   Int      @default(0)
  paymentId    String?
  registeredAt DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  workshop     Workshop @relation(fields: [workshopId], references: [id])

  @@unique([workshopId, userId])
  @@index([userId])
  @@index([workshopId])
}

model Event {
  id              String              @id @default(cuid())
  organizerId     String
  title           String
  description     String
  type            String
  format          String
  startsAt        DateTime
  endsAt          DateTime?
  venue           String?
  meetingLink     String?
  capacity        Int?
  registeredCount Int                 @default(0)
  priceInr        Int                 @default(0)
  campus          String?
  institution     String?
  isFeatured      Boolean             @default(false)
  status          String              @default("UPCOMING")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organizer       User                @relation("EventOrganizer", fields: [organizerId], references: [id])
  registrations   EventRegistration[]

  @@index([organizerId])
  @@index([status])
  @@index([startsAt])
  @@index([type])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  userId       String
  status       String   @default("REGISTERED")
  paidAmount   Int      @default(0)
  paymentId    String?
  registeredAt DateTime @default(now())
  event        Event    @relation(fields: [eventId], references: [id])
  user         User     @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  type            String
  targetId        String
  amountInr       Int
  currency        String    @default("INR")
  status          String    @default("PENDING")
  provider        String?
  externalId      String?
  externalOrderId String?
  failureReason   String?
  refundedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([type])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}
